# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
# Encontre esses valores em: https://app.supabase.com > Project Settings > API

SUPABASE_URL=https://seu-projeto.supabase.co
# SUPABASE_KEY (publishable - deprecated): sb_publishable_XXXXXXXXXXXXXXXXXXXXX
# SUPABASE_KEY (service_role - deprecated): sb_secret_XXXXXXXXXXXXXXXXXXXXX
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNldS1wcm9qZXRvIn0.XXXXXXXXXXXXXXXXXXXXX
# NOTE: URL acima DEVE estar sem "/" no final

# Schema Postgres multi-tenant usado pelos scripts Python (via supabase_client.py).
# Default: "public" (comportamento antigo, sem isolamento por cliente).
# Para operar sobre o schema dedicado de um cliente (ex: "paulo_robson"), criado
# via SQL_schema/criar_schema_cliente.sql, defina o nome do schema abaixo.
# IMPORTANTE: o schema precisa estar em Settings > API > Exposed schemas no
# painel do Supabase, senão a API REST retorna erro mesmo com tudo certo aqui.
SUPABASE_SCHEMA=paulo_robson

# ============================================================================
# GOOGLE DRIVE CONFIGURATION (OAuth 2.0 - Conta Pessoal)
# ============================================================================
# Sincronização automática de orçamentos para Google Drive

# Ativar/desativar sincronização
GOOGLE_DRIVE_ENABLED=true

# Folder ID da pasta raiz no Google Drive
# URL: https://drive.google.com/drive/folders/SEU_FOLDER_ID_AQUI
# Os orçamentos serão salvos em pastas dentro deste diretório
GOOGLE_DRIVE_FOLDER_ID=1hh8APinmIZ9CNT98yZ2DJP2H-q0gk1Ou

# OAuth 2.0 Credentials (Google Cloud Console)
# ⚠️ NÃO COMMITAR ESTE ARQUIVO NO GIT!
# Obtenha em: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=123456789-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-XXXXXXXXXXXXXXXXXXXXX

# OAuth Token (Salvo após primeira autenticação)
# ⚠️ NÃO COMMITAR ESTE ARQUIVO NO GIT!
# ✅ Este token funciona perfeitamente em VPS - copie diretamente do .env local
# Será gerado automaticamente na primeira autenticação
# IMPORTANTE: Use o valor real do seu .env local, não este placeholder
GOOGLE_OAUTH_TOKEN=ya29.XXXXXXXXXXXXXXXXXXXXX
GOOGLE_OAUTH_TOKEN_URI=https://oauth2.googleapis.com/token
# Refresh token (preenchido automaticamente quando disponível)
GOOGLE_OAUTH_TOKEN_REFRESH=
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/drive
# Data de expiração do token (formato ISO 8601: YYYY-MM-DDTHH:MM:SSZ)
# Será atualizado automaticamente pelo google_token_refresh.py
GOOGLE_OAUTH_EXPIRY=2026-05-14T15:41:23Z

# Caminho para arquivo de credenciais (opcional - só se gerar novo token)
GOOGLE_OAUTH_CREDENTIALS_FILE=.credentials/oauth_credentials.json
GOOGLE_OAUTH_TOKEN_PATH=.credentials/google_token.json

# ============================================================================
# SMTP CONFIGURATION (Email) - Opcional
# ============================================================================

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_ou_app_password_aqui
