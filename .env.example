# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
# Encontre esses valores em: https://app.supabase.com > Project Settings > API

SUPABASE_URL=https://seu_projeto.supabase.co
SUPABASE_KEY=sb_publishable_SEU_KEY_AQUI

# ============================================================================
# GOOGLE DRIVE CONFIGURATION (OAuth 2.0)
# ============================================================================
# Sincronização automática de orçamentos para Google Drive

# Ativar/desativar sincronização
GOOGLE_DRIVE_ENABLED=true

# Folder ID da pasta raiz no Google Drive
# URL exemplo: https://drive.google.com/drive/folders/1hh8APinmIZ9CNT98yZ2DJP2H-q0gk1Ou
# Cole apenas o ID (parte final da URL)
GOOGLE_DRIVE_FOLDER_ID=SEU_FOLDER_ID_AQUI

# OAuth 2.0 Credentials (Google Cloud Console)
# Encontre em: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=SEU_CLIENT_ID.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=SEU_CLIENT_SECRET_AQUI

# OAuth Token (Salvo após primeira autenticação)
# ⚠️ IMPORTANTE: Copie o token completo do seu .env local para a VPS
# Formato: ya29.xxxxxxxxxx...
GOOGLE_OAUTH_TOKEN=ya29.SEU_TOKEN_COMPLETO_AQUI

# URLs e configurações OAuth
GOOGLE_OAUTH_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_OAUTH_SCOPES=["https://www.googleapis.com/auth/drive"]
GOOGLE_OAUTH_EXPIRY=2026-05-14T15:41:23Z

# Caminho para arquivo de credenciais (Opcional - para novo token)
GOOGLE_OAUTH_CREDENTIALS_FILE=.credentials/oauth_credentials.json
GOOGLE_OAUTH_TOKEN_PATH=.credentials/google_token.json

# ============================================================================
# SMTP CONFIGURATION (Email - Opcional)
# ============================================================================

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_aqui
